         cpu_executable->thunks().Execute(execute_params);
 
@@ -1852,6 +1869,10 @@ PjRtRawLoadedExecutable::RawExecuteResult CpuPjRtRawLoadedExecutable::Execute(
            {"device_ordinal", run_options.device_ordinal()}});
     });
     tsl::BlockUntilReady(thunks_execute_event);
+    if (owns_kernel_args_cache) {
+      cpu_executable->kernel_args_cache_in_flight().store(
