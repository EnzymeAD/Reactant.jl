 #include <queue>
 #include <string>
@@ -39,8 +41,59 @@ limitations under the License.
 #include "xla/runtime/execution_graph.h"
 #include "xla/tsl/concurrency/async_value_ref.h"
 
+#if defined(__linux__)
+#include <sched.h>
+#endif
+
 namespace xla::cpu {
 
+// Impulse XLA:CPU runtime levers, decided once per process at first use.
+//   A: force the sequential thunk executor (thunk_executor.cc).
+//   B: cache resolved kernel arguments per executable (kernel_thunk.cc, guarded
+//      in cpu_client.cc).
+// Default: ON only when the process is confined to at most two CPUs (one
+// physical core with or without its SMT sibling), where a parallel thunk
+// executor is pure overhead and the argument cache is worth its guard; OFF
+// otherwise, so multi-core runs execute the stock code paths. Per lever, env
+// XLA_CPU_FORCE_SEQUENTIAL_THUNK_EXECUTOR / XLA_CPU_CACHE_KERNEL_ARGS set to
+// exactly "0" forces it off and exactly "1" forces it on; anything else
+// (including unset) uses the affinity rule. XLA_CPU_RUNTIME_LEVERS_DEBUG=1
+// prints the affinity count and both decisions to stderr once.
+struct ImpulseRuntimeLevers {
+  int affinity_cpus;  // CPU_COUNT of sched_getaffinity, -1 if unavailable
+  bool force_sequential;
+  bool cache_kernel_args;
+};
+
+inline const ImpulseRuntimeLevers& GetImpulseRuntimeLevers() {
+  static const ImpulseRuntimeLevers levers = [] {
+    int cpus = -1;
+#if defined(__linux__)
+    cpu_set_t set;
+    if (sched_getaffinity(0, sizeof(set), &set) == 0) cpus = CPU_COUNT(&set);
+#endif
+    const bool one_core = cpus > 0 && cpus <= 2;
+    auto decide = [one_core](const char* name) {
+      const char* v = std::getenv(name);
+      if (v != nullptr && v[0] == '0' && v[1] == '\0') return false;
+      if (v != nullptr && v[0] == '1' && v[1] == '\0') return true;
+      return one_core;
+    };
+    ImpulseRuntimeLevers l{cpus,
+                           decide("XLA_CPU_FORCE_SEQUENTIAL_THUNK_EXECUTOR"),
+                           decide("XLA_CPU_CACHE_KERNEL_ARGS")};
+    const char* dbg = std::getenv("XLA_CPU_RUNTIME_LEVERS_DEBUG");
+    if (dbg != nullptr && dbg[0] == '1' && dbg[1] == '\0') {
+      std::fprintf(stderr,
+                   "XLA_CPU_RUNTIME_LEVERS affinity_cpus=%d "
+                   "force_sequential=%d cache_kernel_args=%d\n",
+                   l.affinity_cpus, l.force_sequential, l.cache_kernel_args);
+    }
+    return l;
+  }();
+  return levers;
+}
