Don't include <byteswap.h> when compiling with nvcc: nvcc chokes on the
glibc byteswap macros, so fall back to protobuf's own bswap_* definitions.

--- a/src/google/protobuf/stubs/port.h
+++ b/src/google/protobuf/stubs/port.h
@@ -27,7 +27,7 @@
 #include <intrin.h>
 #elif defined(__APPLE__)
 #include <libkern/OSByteOrder.h>
-#elif defined(__linux__) || defined(__ANDROID__) || defined(__CYGWIN__)
+#elif !defined(__NVCC__) && (defined(__linux__) || defined(__ANDROID__) || defined(__CYGWIN__))
 #include <byteswap.h>  // IWYU pragma: export
 #endif
 
@@ -136,7 +136,7 @@
 #define bswap_32(x) OSSwapInt32(x)
 #define bswap_64(x) OSSwapInt64(x)
 
-#elif !defined(__linux__) && !defined(__ANDROID__) && !defined(__CYGWIN__)
+#elif defined(__NVCC__) || (!defined(__linux__) && !defined(__ANDROID__) && !defined(__CYGWIN__))
 
 #ifndef bswap_16
 static inline uint16_t bswap_16(uint16_t x) {
