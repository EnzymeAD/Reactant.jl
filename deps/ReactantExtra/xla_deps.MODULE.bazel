# The patch files are vendored by scripts/sync_upstream_patches.sh.
##############################################################

single_version_override(
    module_name = "grpc",
    patch_strip = 1,
    patches = ["//patches/upstream:grpc.patch"],
    version = "1.81.0",
)

single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = [
        "//patches/upstream:protobuf_arena.patch",
        "//patches/upstream:fix_message_lite_incomplete_type.patch",
        "//patches/upstream:fix_python_dist_package.patch",
        # Ours: nvcc cannot digest glibc's <byteswap.h>.
        "//patches:protobuf_nvcc_byteswap.patch",
    ],
    version = "32.1",
)

single_version_override(
    module_name = "abseil-cpp",
    patch_strip = 1,
    patches = [
        "//patches/upstream:btree.patch",
        "//patches/upstream:build_dll.patch",
