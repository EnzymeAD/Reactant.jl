{
  "model": {
    "class": "stochastic_volatility.StochasticVolatility",
    "args": {
      "n": 30,
      "phi": 0.95
    },
    "seed": 12345
  },
  "iterations": 1500,
  "num_warmup": 500,
  "trials": 2,
  "ppls": [
    {
      "name": "impulse",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.1,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true,
          "disable_sicm": true
        }
      },
      "legend": {
        "name": "No SICM",
        "color": "orange"
      },
      "trials": 4
    },
    {
      "name": "impulse",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.1,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true,
          "no_opt": true
        }
      },
      "legend": {
        "name": "No opt",
        "color": "gray"
      },
      "trials": 4
    }
  ],
  "save_samples": false,
  "figures": {
    "generate_pll": false
  }
}
