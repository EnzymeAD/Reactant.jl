{
  "model": {
    "class": "n_schools.NSchools",
    "args": {
      "n": 10000
    },
    "seed": 12345
  },
  "iterations": 10000,
  "num_warmup": 5000,
  "trials": 4,
  "ppls": [
    {
      "name": "impulse",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.1,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true
        }
      },
      "legend": {
        "name": "Full",
        "color": "red"
      },
      "trials": 8
    },
    {
      "name": "impulse",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.1,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true,
          "disable_sicm": true
        }
      },
      "legend": {
        "name": "No SICM",
        "color": "orange"
      },
      "trials": 8
    },
    {
      "name": "impulse",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.1,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true,
          "no_opt": true
        }
      },
      "legend": {
        "name": "No opt",
        "color": "gray"
      },
      "trials": 8
    }
  ],
  "save_samples": true,
  "figures": {
    "generate_pll": true,
    "suffix": "png"
  }
}
