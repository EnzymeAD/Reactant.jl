{
  "model": {
    "class": "hierarchical_mvn.HierarchicalMVN",
    "args": {
      "n": 60,
      "K": 40,
      "J": 2
    },
    "seed": 12345
  },
  "iterations": 200,
  "num_warmup": 50,
  "trials": 2,
  "ppls": [
    {
      "name": "numpyro",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.01,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true
        }
      },
      "legend": {
        "name": "NumPyro",
        "color": "blue"
      },
      "trials": 2
    },
    {
      "name": "impulse",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.01,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true
        }
      },
      "legend": {
        "name": "Full SICM",
        "color": "red"
      },
      "trials": 2
    }
  ],
  "save_samples": true,
  "figures": {
    "generate_pll": true,
    "suffix": "png"
  }
}