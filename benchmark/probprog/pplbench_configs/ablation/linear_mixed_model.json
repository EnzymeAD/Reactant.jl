{
  "model": {
    "class": "linear_mixed_model.LinearMixedModel",
    "args": {"n": 60, "k": 30, "q": 15},
    "seed": 12345
  },
  "iterations": 200,
  "num_warmup": 50,
  "trials": 2,
  "ppls": [
    {
      "name": "impulse",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.05,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true
        }
      },
      "legend": {"name": "Full SICM", "color": "red"},
      "trials": 2
    },
    {
      "name": "impulse",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.05,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true,
          "no_opt": true
        }
      },
      "legend": {"name": "No opt", "color": "gray"},
      "trials": 2
    }
  ],
  "save_samples": true,
  "figures": {"generate_pll": true, "suffix": "png"}
}
