{
  "model": {
    "class": "car_spatial.CARSpatial",
    "args": {"n": 50, "rho": 0.99},
    "seed": 12345
  },
  "iterations": 500,
  "num_warmup": 200,
  "trials": 2,
  "ppls": [
    {
      "name": "impulse",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.05,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true
        }
      },
      "legend": {"name": "Full SICM", "color": "red"},
      "trials": 2
    },
    {
      "name": "impulse",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.05,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true,
          "no_opt": true
        }
      },
      "legend": {"name": "No opt", "color": "gray"},
      "trials": 2
    }
  ],
  "save_samples": true,
  "figures": {"generate_pll": true, "suffix": "png"}
}
