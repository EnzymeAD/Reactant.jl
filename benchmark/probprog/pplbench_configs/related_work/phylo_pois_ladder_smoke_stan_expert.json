{
  "model": {
    "class": "phylo_pois.PhyloPois",
    "args": {
      "n": 200
    },
    "seed": 12345
  },
  "iterations": 40,
  "num_warmup": 20,
  "trials": 2,
  "ppls": [
    {
      "name": "stan",
      "package": "pplbench.ppls.stan_ladder_phylo.expert",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.05,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true
        }
      },
      "legend": {
        "name": "Stan (expert, brms)",
        "color": "#222222"
      },
      "trials": 2,
      "seed": 20260822
    }
  ],
  "save_samples": true,
  "figures": {
    "generate_pll": true,
    "suffix": "png"
  }
}