{
  "model": {
    "class": "phylo_pois.PhyloPois",
    "args": {
      "n": 200
    },
    "seed": 12345
  },
  "iterations": 10,
  "num_warmup": 5,
  "trials": 2,
  "save_samples": true,
  "figures": {
    "generate_pll": true,
    "suffix": "png"
  },
  "ppls": [
    {
      "name": "impulse",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.1,
          "max_tree_depth": 8,
          "adapt_step_size": true,
          "adapt_mass_matrix": true
        }
      },
      "legend": {
        "name": "Impulse",
        "color": "red"
      },
      "trials": 2
    }
  ]
}