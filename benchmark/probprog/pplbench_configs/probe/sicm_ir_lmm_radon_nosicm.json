{
  "model": {
    "class": "linear_mixed_model.LinearMixedModel",
    "args": {
      "dataset": "radon_mn",
      "n": 250,
      "k": 2
    },
    "seed": 12345
  },
  "iterations": 6,
  "num_warmup": 3,
  "trials": 2,
  "ppls": [
    {
      "name": "impulse",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.05,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true,
          "disable_sicm": true
        }
      },
      "legend": {
        "name": "No SICM",
        "color": "gray"
      },
      "trials": 2
    }
  ],
  "save_samples": false,
  "figures": {
    "generate_pll": false,
    "suffix": "png"
  }
}
