{
  "model": {
    "class": "crowd_sourced_annotation.CrowdSourcedAnnotation",
    "args": {
      "n": 2000,
      "k": 10,
      "num_categories": 3,
      "expected_correctness": 0.8,
      "num_labels_per_item": 3,
      "concentration": 10
    },
    "seed": 12345
  },
  "iterations": 100,
  "num_warmup": 30,
  "trials": 2,
  "ppls": [
    {
      "name": "turing",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.1,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true
        }
      },
      "legend": { "name": "Turing.jl", "color": "purple" },
      "trials": 1
    }
  ],
  "save_samples": true,
  "figures": { "generate_pll": true, "suffix": "png" }
}
