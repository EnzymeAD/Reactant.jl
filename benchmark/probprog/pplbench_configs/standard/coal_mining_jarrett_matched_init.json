{
  "model": {
    "class": "coal_mining.CoalMining",
    "args": {
      "n": 111,
      "dataset": "jarrett"
    },
    "seed": 12345
  },
  "iterations": 4000,
  "num_warmup": 1000,
  "trials": 4,
  "ppls": [
    {
      "name": "numpyro",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.1,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true,
          "matched_init": true
        }
      },
      "legend": {
        "name": "NumPyro",
        "color": "blue"
      },
      "trials": 4
    },
    {
      "name": "impulse",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.1,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true
        }
      },
      "legend": {
        "name": "Impulse",
        "color": "red"
      },
      "trials": 4
    }
  ],
  "save_samples": true,
  "figures": {
    "generate_pll": true,
    "suffix": "png"
  }
}