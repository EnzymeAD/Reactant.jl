{
  "model": {
    "class": "noisy_or_topic.NoisyOrTopic",
    "args": {
      "n": 2,
      "num_topics": 10,
      "num_words": 20,
      "avg_fanout": 3.0,
      "avg_leak_weight": 0.1,
      "avg_topic_weight": 1.0
    },
    "seed": 12345
  },
  "iterations": 1000,
  "num_warmup": 500,
  "trials": 2,
  "ppls": [
    {
      "name": "impulse",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.1,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true
        }
      },
      "legend": { "name": "Impulse", "color": "red" },
      "trials": 2
    },
    {
      "name": "stan",
      "inference": {
        "class": "inference.MCMC",
        "infer_args": {
          "step_size": 0.1,
          "max_tree_depth": 10,
          "adapt_step_size": true,
          "adapt_mass_matrix": true
        }
      },
      "legend": { "name": "Stan", "color": "green" },
      "trials": 2
    }
  ],
  "save_samples": true,
  "figures": { "generate_pll": true, "suffix": "png" }
}
